# Environment variables for local development

# MLflow Tracking Server
export MLFLOW_TRACKING_URI=http://localhost:5000
export MLFLOW_TRACKING_USERNAME=user
export MLFLOW_TRACKING_PASSWORD=password

# Azure Storage (DVC & MLflow artifacts)
export AZURE_STORAGE_ACCOUNT=stmlopsdvc123
export AZURE_STORAGE_CONTAINER=dvc
export AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...

# DVC Configuration
export DVC_AZURE_STORAGE_CONNECTION_STRING=$AZURE_STORAGE_CONNECTION_STRING

# GitHub (optional, for local testing)
export GITHUB_SHA=abc123def456

# MLflow Backend Store (PostgreSQL recommended for production)
# export MLFLOW_BACKEND_STORE_URI=postgresql://user:password@localhost/mlflow
# export MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://my-bucket/mlflow-artifacts

# Azure ML (optional)
# export AZUREML_SUBSCRIPTION_ID=...
# export AZUREML_RESOURCE_GROUP=...
# export AZUREML_WORKSPACE_NAME=...
